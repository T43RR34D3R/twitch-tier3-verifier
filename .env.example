# Database Configuration
RAILWAY_DATABASE_URL=postgresql://user:password@host:port/database

# NextAuth Configuration (Required)
NEXTAUTH_SECRET=your_random_secret_here_generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# Discord OAuth (for Discord authentication)
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Twitch OAuth (optional - for Twitch authentication and IGDB access)
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# IGDB (for game search)
# Note: IGDB uses Twitch OAuth credentials, so this should be your Twitch Client ID
IGDB_CLIENT_ID=your_twitch_client_id

# Optional: SMS Notifications (if using Twilio)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone_number
